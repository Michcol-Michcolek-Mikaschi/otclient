Module
  name: loot_stats
  description: Module who make statistics of loot.
  author: EgzoT
  website: https://github.com/EgzoT/-OTClient-Mod-loot_stats
  version: 1.3.0

  autoload: true
  autoload-priority: 1000
  sandboxed: true
  dependencies: [ game_interface, client_options ]
  scripts: [ loot_stats ]
  @onLoad: controller:init()
  @onUnload: controller:terminate()
