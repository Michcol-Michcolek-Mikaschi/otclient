MarketOfferLabel < Label
  font: verdana-11px-monochrome
  background-color: alpha
  text-offset: 2 0
  focusable: true
  phantom: false

MainWindow
  id: marketWindow
  text: Global Market
  size: 600 500
  @onEscape: toggle()

  TabBar
    id: marketTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5

  Panel
    id: contentPanel
    anchors.top: marketTabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 40

  Button
    id: closeButton
    text: Close
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 10
    margin-bottom: 10
    @onClick: modules.game_market.toggle()

  Panel
    id: buyPanel
    anchors.fill: contentPanel
    visible: false
    
    TextList
      id: categoryList
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 90
      margin-top: 10
      margin-bottom: 10
      focusable: false
      vertical-scrollbar: categoryListScrollBar

    VerticalScrollBar
      id: categoryListScrollBar
      anchors.top: categoryList.top
      anchors.bottom: categoryList.bottom
      anchors.left: categoryList.right
      step: 14
      pixels-scroll: true

    Label
      id: searchLabel
      text: Search:
      anchors.top: parent.top
      anchors.left: categoryListScrollBar.right
      margin-top: 13
      margin-left: 10
      width: 45

    TextEdit
      id: searchInput
      anchors.verticalCenter: searchLabel.verticalCenter
      anchors.left: searchLabel.right
      anchors.right: detailsPanel.left
      margin-right: 10
      @onTextChange: modules.game_market.onSearchTextChange(self:getText())

    ComboBox
      id: sortComboBox
      anchors.top: searchInput.bottom
      anchors.right: detailsPanel.left
      width: 150
      margin-top: 5
      margin-right: 10

    TextList
      id: offerList
      anchors.top: sortComboBox.bottom
      anchors.left: categoryListScrollBar.right
      anchors.bottom: parent.bottom
      anchors.right: detailsPanel.left
      margin-top: 10
      margin-bottom: 10
      margin-left: 10
      margin-right: 10
      vertical-scrollbar: offerListScrollBar
      focusable: false

    VerticalScrollBar
      id: offerListScrollBar
      anchors.top: offerList.top
      anchors.bottom: offerList.bottom
      anchors.right: offerList.right
      step: 14
      pixels-scroll: true

    Panel
      id: detailsPanel
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 200
      margin-top: 10
      border-width: 1
      border-color: #00000077
      background-color: #ffffff11

      UIItem
        id: itemPreview
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 20
        size: 64 64
        virtual: true

      Label
        id: itemName
        anchors.top: itemPreview.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 10
        text-align: center
        font: verdana-11px-rounded

      Label
        id: itemPrice
        anchors.top: itemName.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
        text-align: center
        color: #ffff00
        font: verdana-11px-rounded

      Label
        id: itemSeller
        anchors.top: itemPrice.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
        text-align: center
        color: #aaaaaa
        font: verdana-11px-rounded

      Label
        id: itemStats
        anchors.top: itemSeller.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: buyButton.top
        margin-top: 10
        margin-left: 5
        margin-right: 5
        text-align: top
        text-wrap: true
        font: verdana-11px-rounded

      Button
        id: buyButton
        text: Buy Offer
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 10
        enabled: false
        @onClick: modules.game_market.buySelectedOffer()

  Panel
    id: createOfferPanel
    anchors.fill: contentPanel
    visible: false

    Label
      text: Drag and drop an item here to sell
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 20

    Panel
      id: sellSlotPanel
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      size: 36 36
      border-width: 1
      border-color: #888888
      background-color: #00000044
      droppable: true

      UIItem
        id: sellItemDisplay
        anchors.centerIn: parent
        size: 32 32
        virtual: true
        phantom: true

    Label
      text: Price:
      anchors.top: sellSlotPanel.bottom
      anchors.left: parent.left
      margin-top: 20
      margin-left: 150

    TextEdit
      id: priceInput
      anchors.verticalCenter: prev.verticalCenter
      anchors.left: prev.right
      anchors.right: parent.right
      margin-left: 10
      margin-right: 150
      text-align: center

    Button
      id: createOfferButton
      text: Create Offer
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 20
      width: 120
      @onClick: modules.game_market.createOffer()

  Panel
    id: sellPanel
    anchors.fill: contentPanel
    visible: false

    TextList
      id: myOffersList
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 210
      margin-top: 30
      margin-bottom: 10
      vertical-scrollbar: myOffersListScrollBar
      focusable: false

    VerticalScrollBar
      id: myOffersListScrollBar
      anchors.top: myOffersList.top
      anchors.bottom: myOffersList.bottom
      anchors.right: myOffersList.right
      step: 14
      pixels-scroll: true

    Button
      id: cancelButton
      text: Cancel Offer
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      width: 100
      margin-bottom: 10
      margin-right: 10
      @onClick: modules.game_market.cancelSelectedOffer()
