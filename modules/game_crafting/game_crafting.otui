TextListLabel < Label
  font: verdana-11px-monochrome
  background-color: alpha
  text-offset: 2 0
  focusable: true
  height: 16
  
  $focus:
    background-color: #ffffff22
    color: #ffffff

CraftingTabBar < TabBar
CraftingTabBarPanel < TabBarPanel
CraftingTabBarButton < TabBarButton
  size: 80 25
  font: verdana-11px-rounded
  text-offset: 0 2
  margin-right: 2

  $hover !checked:
    color: #ffffff

  $checked:
    color: #ffffff
    background-color: #ffffff22
    border-bottom: 2 alpha

  $on !checked:
    color: #f55e5e

IngredientItem < UIItem
  size: 34 34
  margin-right: 5
  virtual: true
  image-source: /images/game/slots/inventory-back

MainWindow
  id: craftingWindow
  !text: tr('Crafting System')
  size: 600 450
  @onEscape: modules.game_crafting.toggle()

  CraftingTabBar
    id: craftingTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5

  Panel
    id: contentPanel
    anchors.top: craftingTabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 10

  Button
    id: closeButton
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 80
    @onClick: modules.game_crafting.toggle()

  Panel
    id: craftingPanel
    anchors.fill: contentPanel
    visible: false

    Label
      !text: tr('Place items in slots:')
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 20

    Panel
      id: slotsPanel
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 20
      height: 40
      width: 200
      layout:
        type: horizontalBox
        spacing: 5

      Item
        id: slot1
        size: 34 34
        virtual: true
        droppable: true
        image-source: /images/game/slots/inventory-back
        
      Item
        id: slot2
        size: 34 34
        virtual: true
        droppable: true
        image-source: /images/game/slots/inventory-back

      Item
        id: slot3
        size: 34 34
        virtual: true
        droppable: true
        image-source: /images/game/slots/inventory-back

      Item
        id: slot4
        size: 34 34
        virtual: true
        droppable: true
        image-source: /images/game/slots/inventory-back

      Item
        id: slot5
        size: 34 34
        virtual: true
        droppable: true
        image-source: /images/game/slots/inventory-back

    Label
      id: resultLabel
      !text: tr('Result:')
      anchors.top: slotsPanel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 30

    Item
      id: resultItem
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5
      size: 34 34
      virtual: true

    Button
      id: craftButton
      !text: tr('CRAFT')
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      width: 100
      height: 30
      @onClick: modules.game_crafting.craft()

  Panel
    id: recipesPanel
    anchors.fill: contentPanel
    visible: false

    TextList
      id: recipesList
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 200
      margin-right: 10
      vertical-scrollbar: recipesListScrollBar
      focusable: false

    VerticalScrollBar
      id: recipesListScrollBar
      anchors.top: recipesList.top
      anchors.bottom: recipesList.bottom
      anchors.left: recipesList.right

    Panel
      id: recipeDetailsPanel
      anchors.top: parent.top
      anchors.left: recipesListScrollBar.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 10
      
      Label
        id: recipeNameLabel
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        font: verdana-11px-rounded
        text-align: center

      Label
        id: ingredientsLabel
        !text: tr('Ingredients:')
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 20

      Panel
        id: recipeIngredientsPanel
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 40
        margin-top: 5
        padding: 3
        fit-children: true
        layout:
          type: horizontalBox
          spacing: 5

      Label
        !text: tr('Result:')
        anchors.top: recipeIngredientsPanel.bottom
        anchors.left: parent.left
        margin-top: 20

      Item
        id: recipeResultItem
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 5
        size: 34 34
        virtual: true
        image-source: /images/game/slots/inventory-back
